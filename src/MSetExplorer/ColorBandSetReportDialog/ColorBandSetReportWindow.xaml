<Window x:Class="MSetExplorer.ColorBandSetReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer"
        d:DataContext="{d:DesignInstance Type=local:ColorBandSetReportViewModel}"
        mc:Ignorable="d"
        Title="ColorBandSet Report Window" Height="1100" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border x:Name="borderTitle" Grid.Row="0" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" >

                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Width="40" Margin="3, 0" Text="Name:" />
                    <TextBox x:Name="txtName" Text="{Binding ColorBandSet.Name}" Width="460"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!--Report Body-->
        <Border x:Name="borderReport" Grid.Row="1" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,5" >
            <!--<TextBlock x:Name="txtBlkReport" Margin="3, 0" Text="This is the report body"  />-->

            <ListView Margin="10" Name="lvColorMapCountInfos" IsSynchronizedWithCurrentItem="True" SelectedItem="{Binding SelectedColorMapCountInfo}">

                <!--<ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,1,2,1" >Serial Number:</TextBlock>
                                    <TextBlock Text="{Binding ColorBandSerialNumber}"/>
                                </StackPanel>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>-->

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Count" Width="50" DisplayMemberBinding="{Binding CountVal}" />
                        <GridViewColumn Header="MapIndex" Width="50" DisplayMemberBinding="{Binding ColorMapIndex}" />
                        <GridViewColumn Header="Step" Width="80" DisplayMemberBinding="{Binding StepFactor}" />

                        <GridViewColumn Header="R" Width="80" DisplayMemberBinding="{Binding R}" />
                        <GridViewColumn Header="G" Width="80" DisplayMemberBinding="{Binding G}" />
                        <GridViewColumn Header="B" Width="80" DisplayMemberBinding="{Binding B}" />

                        <GridViewColumn Header="L" Width="80" DisplayMemberBinding="{Binding L}" />
                        <GridViewColumn Header="C" Width="80" DisplayMemberBinding="{Binding C}" />
                        <GridViewColumn Header="H" Width="80" DisplayMemberBinding="{Binding H}" />
                    </GridView>
                </ListView.View>
            </ListView>

        </Border>

        <!-- Close Button -->
        <Border Grid.Row="2" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button Name="btnClose" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="0,0,0,10" Click="CloseButton_Click" IsCancel="True" IsDefault="True">_Close</Button>
            </StackPanel>

        </Border>

    </Grid>
</Window>
