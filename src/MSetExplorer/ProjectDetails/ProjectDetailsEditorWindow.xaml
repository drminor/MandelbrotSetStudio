<Window x:Class="MSetExplorer.ProjectDetailsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer" d:DataContext="{d:DesignInstance Type=local:ProjectDetailsViewModel}"
        mc:Ignorable="d"
        Title="Edit Project" Height="500" Width="820">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,50,5,5">
            <!--<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                <TextBlock Margin="20, 5, 1, 5">Jobs and MapSection Details for Poster:</TextBlock>
                <TextBlock Text="{Binding OwnerName}" Margin="2, 5, 20, 5"/>

                <TextBlock Margin="200, 5, 1, 5">Current Collection Size in Mb:</TextBlock>
                <TextBlock Text="{Binding MapSectionCollectionSize, StringFormat=n0}" Width="100" Margin="2, 5, 20, 5"/>

            </StackPanel>-->
        </Border>

        <!--
        
        Id
        DateCreated
        
        Name                                *
        Description                         *
        ColorBandSet Resolution Strategy    *

        Number of Jobs
        Number of ColorBandsets
        Number of Distinct Target Iterations

        LastSaved
        LastUpdated

        Current Job
            Target Iterations
            Threshold
            Calculate Escape Velocities
            Save The ZValues
        
            Zoom Depth
            Limb Count
        
        Current ColorBandSet
            Use Percentages

        OnFile

        Is Dirty

        Any ColorBandSet Is Dirty
        JobTree Isirty
        Any Job Is Dirty
        Number Of Jobs Not Saved
        Number Of ColorBandSets NotSaved
        
        Is Current JobId Changed
        
        -->
        
        
        <Border x:Name="borderDetails" Grid.Row="1" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,20">

            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Margin="20,0,0,0">

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Width="130" FontSize="16" Margin="10,5,1,5">Name</TextBlock>
                    <TextBlock Width="280" FontSize="16" Margin="2,5,1,5" Text="{Binding Name}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Width="130" FontSize="16" Margin="10,5,1,5">Description:</TextBlock>
                    <TextBlock Width="280" FontSize="16" Margin="2,5,1,5" Text="{Binding Description}"/>
                </StackPanel>

            </StackPanel>

        </Border>

        <Border Grid.Row="2" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Name="btnClose" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="10" Click="CloseButton_Click" IsCancel="True">_Close</Button>
            </StackPanel>

        </Border>

    </Grid>
</Window>
