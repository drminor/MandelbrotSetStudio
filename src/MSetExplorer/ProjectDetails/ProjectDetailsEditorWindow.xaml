<Window x:Class="MSetExplorer.ProjectDetailsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer" d:DataContext="{d:DesignInstance Type=local:ProjectDetailsViewModel}"
        mc:Ignorable="d"
        Title="Edit Project" Height="500" Width="820">

    <Window.Resources>
        <ResourceDictionary>
            <local:CbsResolutionStrategyToIntConverter x:Key="CbsResolutionStrategyConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,50,5,5">
            <!--<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                <TextBlock Margin="20, 5, 1, 5">Jobs and MapSection Details for Poster:</TextBlock>
                <TextBlock Text="{Binding OwnerName}" Margin="2, 5, 20, 5"/>

                <TextBlock Margin="200, 5, 1, 5">Current Collection Size in Mb:</TextBlock>
                <TextBlock Text="{Binding MapSectionCollectionSize, StringFormat=n0}" Width="100" Margin="2, 5, 20, 5"/>

            </StackPanel>-->
        </Border>

        <!--
        
        Id
        DateCreated
        
        Name                                *
        Description                         *
        ColorBandSet Resolution Strategy    *

        Number of Jobs
        Number of ColorBandSets
        Number of Distinct Target Iterations

        Current Job
            Target Iterations
            Calculate Escape Velocities
            Save The ZValues
        
                ++ TODO: Record the setting of 'UseEscapeVelocities' with each ZValue Record
                AND make sure not to use a ZValue record having a value for UseEscapeVelocities other than the current Job's setting.

            Zoom Depth
            Limb Count
        
        Current ColorBandSet
            Use Percentages

        OnFile
        Any Update Pending
        LastSaved
        LastUpdated
        Number Of Jobs Not Saved
        Number Of ColorBandSets NotSaved
        Is Current JobId Changed
        
        ******* These are Workspace Settings *********
        Use Escape Velocities
        [The current setting of] Use Percentages Is Applied Globally
        Highlight Selected Color Band
        
        ******* These are Installation Settings *********
        Block Size
        Threshold
        
        ++ Or perhaps add support having a "Current" MapSection MongoDb Collection that is determined by the BlockSize and Threshold
        
        -->
        
        
        <Border x:Name="borderDetails" Grid.Row="1" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,20">

            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Margin="20,0,0,0">

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Width="130" FontSize="16" Margin="10,5,1,5">Name</TextBlock>
                    <TextBox Width="280" FontSize="16" Margin="2,5,1,5" Text="{Binding Name}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Width="130" FontSize="16" Margin="10,5,1,5">Description:</TextBlock>
                    <TextBox Width="280" FontSize="16" Margin="2,5,1,5" Text="{Binding Description}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Width="130" FontSize="16" Margin="10,5,1,5">CB Res Strategy:</TextBlock>
                    <ComboBox x:Name="cmbBlendStyle" Width="180" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                              FontSize="16"
                            SelectedIndex="{Binding Path=ColorBandSetResolutionStrategy, Converter={StaticResource CbsResolutionStrategyConverter}}">
                        <ComboBoxItem IsSelected="True">Per Project</ComboBoxItem>
                        <ComboBoxItem>Per Job</ComboBoxItem>
                        <ComboBoxItem>Per Job With Version</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </StackPanel>

        </Border>

        <Border Grid.Row="2" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Name="btnSave" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="10" Click="SaveButton_Click" IsDefault="True" >Save</Button>
                <Button Name="btnClose" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="10" Click="CloseButton_Click" IsCancel="True">_Cancel</Button>

            </StackPanel>

        </Border>

    </Grid>
</Window>
