<Window x:Class="MSetExplorer.ColorBandDistributeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer" d:DataContext="{d:DesignInstance Type=local:CbsHistogramViewModel}"
        mc:Ignorable="d"
        Title="Distribute Color Bands" Height="160" Width="300">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="5">

                <!-- Starting / Start Color -->
                <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                    
                    <!--<TextBlock Width="50" Margin="5,0,2,0" FontSize="14" Text="Divide:" HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtNumberOfBands"  Margin="0,0"  Width="30" Height="21" VerticalAlignment="Center" Text="1" HorizontalContentAlignment="Left"/>
                    <TextBlock Width="89" Margin="5,0,2,0" FontSize="14" Text="Bands," />-->

                    <TextBlock Margin="5,0,2,0" FontSize="14" Text="Divide 1 Band" HorizontalAlignment="Left"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,5,0,0">

                    <TextBlock Width="70" Margin="5,0,2,0" FontSize="14" Text="Starting at:" />
                    <TextBox x:Name="startingIndex" Margin="5,0"  Width="30" Height="21" VerticalAlignment="Center" Text="8" HorizontalContentAlignment="Left"/>

                    <TextBlock Width="90" Margin="5,0,2,0" FontSize="14" Text="and ending at:" />
                    <TextBox x:Name="endingIndex" Margin="5,0"  Width="30" Height="21" VerticalAlignment="Center" Text="9" HorizontalContentAlignment="Left"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,5,0,0">

                    <TextBlock Width="26" Margin="5,0,2,0" FontSize="14" Text="Into:" HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtNewNumberOfBands"  Margin="5,0"  Width="30" Height="21" VerticalAlignment="Center" Text="4" HorizontalContentAlignment="Left"/>
                    <TextBlock Width="55" Margin="5,0,2,0" FontSize="14" Text="Bands" HorizontalAlignment="Left"/>

                </StackPanel>

            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="5,5,5,10">
                <Button Name="btnOk" HorizontalAlignment="Center" Width="85" FontSize="14" Margin="10,0" Click="btnOk_Click" IsDefault="True" >_Ok</Button>
                <Button Name="btnClose" HorizontalAlignment="Center" Width="85" FontSize="14" Margin="10,0" Click="btnClose_Click"  IsCancel="True">_Cancel</Button>
            </StackPanel>

        </Border>

    </Grid>
</Window>
