<Window x:Class="MSetExplorer.ProjectOpenSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer" d:DataContext="{d:DesignInstance Type=local:ProjectOpenSaveViewModel}"
        mc:Ignorable="d"
        Title="Open Project" Height="1000" Width="920">

    <Window.CommandBindings>
        <!--<CommandBinding Command="local:CustomCommands.PosterSave" CanExecute="SaveCommand_CanExecute" Executed="SaveCommand_Executed" />-->
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Menu-->
        <Menu Grid.Row="0" Grid.ColumnSpan="4" Height="20">

            <MenuItem Header="_Sort">
                <MenuItem x:Name="mnuItem_sortAz" Header="Sort A-Z" Click="SortAToZ_Click" IsCheckable="True" IsChecked="False" />
                <MenuItem x:Name="mnuItem_sortZa" Header="Sort Z-A" Click="SortZToA_Click"  IsCheckable="True" IsChecked="True" />

                <MenuItem x:Name="mnuItem_sortByLastAccessed" Header="Sort By Last Accessed" Click="SortByLastAccessed_Click" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="mnuItem_sortByDateCreated" Header="Sort By Date Created" Click="SortByDateCreated_Click" IsCheckable="True" IsChecked="False" />
                <MenuItem x:Name="mnuItem_sortByName" Header="Sort By Name" Click="SortByName_Click" IsCheckable="True" IsChecked="False" />
            </MenuItem>

            <MenuItem Header="_Filter">
                <MenuItem x:Name="mnuItem_includeLast10Accessed" Header="Last 10 Accessed" Click="Include10LastAccessed_Click" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="mnuItem_includeLast20Accessed" Header="Last 20 Accessed" Click="Include20LastAccessed_Click" IsCheckable="True" IsChecked="False" />
                <MenuItem x:Name="mnuItem_includeAll" Header="Include All" Click="IncludeAll_Click" IsCheckable="True" IsChecked="False" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,5">

            <ListView Margin="10" Name="lvProjects" IsSynchronizedWithCurrentItem="True" SelectedItem="{Binding SelectedProject}" TabIndex="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Created" Width="160" DisplayMemberBinding="{Binding DateCreatedUtc}" />
                        <GridViewColumn Header="Job Count" Width="80" DisplayMemberBinding="{Binding NumberOfJobs}" />
                        <GridViewColumn Header="Bytes" Width="100" DisplayMemberBinding="{Binding SizeInBytes, StringFormat=n0}" />
                        <GridViewColumn Header="Zoom" Width="70" DisplayMemberBinding="{Binding MinMapCoordsExponent}" />
                        <GridViewColumn Header="Accessed" Width="190" DisplayMemberBinding="{Binding LastAccessedUtc}" />
                    </GridView>
                </ListView.View>
            </ListView>

        </Border>

        <Border x:Name="borderTop" Grid.Row="2" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,5,0">
            <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">

                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Width="90" Margin="10, 0, 20, 0" FontSize="16" Text="Name:" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtName" Text="{Binding SelectedName}"  Width="170" Height="22" TabIndex="2"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Width="90" Margin="10, 0, 20, 0" FontSize="16" Text="Description:" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtDescription" Text="{Binding SelectedDescription}" Width="500" Height="22" TabIndex="3"/>
                </StackPanel>

            </StackPanel>            
        </Border>

        <Border Grid.Row="3" BorderThickness="0" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Name="btnSave" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="10" Click="SaveButton_Click" IsDefault="True" TabIndex="4" >Save</Button>
                <Button Name="btnClose" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="10" Click="CloseButton_Click" IsCancel="True" TabIndex="5">_Cancel</Button>
                <Button Name="btnDelete" HorizontalAlignment="Center" Width="100" FontSize="16" Margin="30,10, 10, 10" Click="DeleteButton_Click" TabIndex="6">_Delete</Button>

                <Button Name="btnViewJobs" HorizontalAlignment="Center" Width="110" FontSize="16" Margin="10" Click="ViewJobsButton_Click">_View Jobs</Button>
                <Button Name="btnTrimMapSectionsHeavy" HorizontalAlignment="Center" Width="160" FontSize="16" Margin="10" Click="TrimMapSectionsHeavyButton_Click">Delete Map Sections</Button>
                <Button Name="btnTrimMapSections" HorizontalAlignment="Center" Width="150" FontSize="16" Margin="10" Click="TrimMapSectionsHeavyButton_Click">Trim Map Sections</Button>

            </StackPanel>

        </Border>

    </Grid>


</Window>
