<Window x:Class="MSetExplorer.ColorBlendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSetExplorer"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d"
        Title="ColorPickerDialog" Width="384" Height="440"
        x:Name="cbdWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="172"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Top">
            <colorpicker:SquarePicker Width="150" Height="150" x:Name="clrPicker1" SmallChange="5" Margin="10"/>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Top">
            <colorpicker:SquarePicker Width="150" Height="150" x:Name="clrPicker2" SmallChange="5" Margin="10"/>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <StackPanel Orientation="Vertical">
                <TextBox Text="Writeable Bitmap"/>

                <Image Width="300" Height="60" Source="{Binding ElementName=cbdWindow, Path=GradientBitmap}" Stretch="Fill" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Vertical">
                <TextBox Text="Linear Gradient Brush"/>

                <Rectangle Width="300" Height="60">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="linearGradientBrush1" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="Yellow" Offset="0.0" />
                            <GradientStop Color="LimeGreen" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

            </StackPanel>
        </Border>
        
        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Height="35">
                <Button Name="btnSave" HorizontalAlignment="Center" Width="85" FontSize="16" Margin="5,5,20,5" Click="SaveButton_Click" IsDefault="True" >Save</Button>
                <Button Name="btnClose" HorizontalAlignment="Center" Width="85" FontSize="16" Margin="5" Click="CloseButton_Click" IsCancel="True">_Cancel</Button>
            </StackPanel>

        </Border>
    </Grid>
</Window>
